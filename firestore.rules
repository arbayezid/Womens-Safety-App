rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── One-way guardian links ──────────────────────────────────────────────
    // A link "B guards A" exists when connection_requests/{A}_{B} (or {A}_{B's email key})
    // was sent by A and accepted by B. A's users/{A}/contacts is the source of truth for who
    // receives A's alerts; B sees the link only through the accepted request.

    // Same key the app builds: lowercase email, every non [a-z0-9] character -> '_'.
    function authEmailKey() {
      return string(request.auth.token.get('email', '')).lower().replace('[^a-z0-9]', '_');
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/connection_requests/$(requestId);
    }

    function isAcceptedRequestToMe(requestId) {
      return exists(requestPath(requestId)) && (
        get(requestPath(requestId)).data.get('status', '') == 'accepted' &&
        (get(requestPath(requestId)).data.get('receiverId', '') == request.auth.uid ||
         get(requestPath(requestId)).data.get('receiver_uid', '') == request.auth.uid)
      );
    }

    // True when the signed-in user accepted a guardian request sent by protectedUid.
    function acceptedGuardianOf(protectedUid) {
      return isAcceptedRequestToMe(protectedUid + '_' + request.auth.uid) ||
        (authEmailKey() != '' && isAcceptedRequestToMe(protectedUid + '_' + authEmailKey()));
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can query and read user profiles to search contacts by phone number
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Active sender-side safety deadlines (journey / ride / SOS escalation timers), mirrored
      // from the device so they can be re-armed after a reinstall. Private to the owner.
      match /safety_deadlines/{deadlineId} {
        allow read, write: if isOwner(userId);
      }

      // Safety & alert history of this account (survives logout, reinstall, new phone).
      // Only the owner can read it. Entries are immutable; routine entries may be cleared by
      // the owner, SOS entries never (evidence).
      match /activity_logs/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == activityId;
        allow update: if false;
        allow delete: if isOwner(userId) && resource.data.get('type', '') != 'sos';
      }

      // Emergency Contacts Subcollection = this user's guardians (one-way links).
      match /contacts/{contactId} {
        // Only the owner can read their own guardians.
        allow read: if isOwner(userId);
        // The owner manages their own list. The guardian (accepter) may add/update their own
        // entry only after accepting a request sent by the owner.
        allow create, update: if isOwner(userId) ||
          (isOwner(contactId) && acceptedGuardianOf(userId));
        // The owner, the guardian themselves (removing the link), or the accepter clearing the
        // owner's email placeholder for them ("pending_<accepter email key>").
        allow delete: if isOwner(userId) ||
          isOwner(contactId) ||
          (isAuthenticated() && authEmailKey() != '' && contactId == 'pending_' + authEmailKey());
      }
    }

    // Phone Number Registry: one document per phone number (ID = +E164 number) naming the single
    // account that owns it. Create-only for yourself and never reassigned, so a number can belong
    // to only one account. Single-document reads only (no listing/enumeration of numbers).
    match /phone_numbers/{phone} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneNumber == phone
        && request.resource.data.keys().hasOnly(['uid', 'phoneNumber', 'createdAt']);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Connection Requests Collection
    match /connection_requests/{requestId} {
      function isSender() {
        return isAuthenticated() && (
          ('senderId' in resource.data && resource.data.senderId == request.auth.uid) ||
          ('sender_uid' in resource.data && resource.data.sender_uid == request.auth.uid) ||
          (request.auth.token.email != null && (
            ('sender_email' in resource.data && (
              resource.data.sender_email == request.auth.token.email ||
              resource.data.sender_email == request.auth.token.email.lower()
            )) ||
            ('senderEmail' in resource.data && (
              resource.data.senderEmail == request.auth.token.email ||
              resource.data.senderEmail == request.auth.token.email.lower()
            ))
          ))
        );
      }

      function isReceiver() {
        return isAuthenticated() && (
          ('receiverId' in resource.data && resource.data.receiverId == request.auth.uid) ||
          ('receiver_uid' in resource.data && resource.data.receiver_uid == request.auth.uid) ||
          (request.auth.token.email != null && (
            ('receiver_email' in resource.data && (
              resource.data.receiver_email == request.auth.token.email ||
              resource.data.receiver_email == request.auth.token.email.lower()
            )) ||
            ('receiverEmail' in resource.data && (
              resource.data.receiverEmail == request.auth.token.email ||
              resource.data.receiverEmail == request.auth.token.email.lower()
            ))
          ))
        );
      }

      allow read: if isSender() || isReceiver();
      
      // Only authenticated users can create requests for themselves as sender
      allow create: if isAuthenticated() 
        && (request.resource.data.senderId == request.auth.uid || request.resource.data.sender_uid == request.auth.uid)
        && request.resource.data.status == 'pending';

      // Who sent the request (= who is protected) can never be rewritten.
      function senderUnchanged() {
        return request.resource.data.get('senderId', null) == resource.data.get('senderId', null) &&
          request.resource.data.get('sender_uid', null) == resource.data.get('sender_uid', null);
      }

      // The receiver may only record themselves as the receiver (no forwarding the link).
      function receiverIsSelf() {
        return (request.resource.data.get('receiverId', '') == resource.data.get('receiverId', '') ||
                request.resource.data.receiverId == request.auth.uid) &&
          (request.resource.data.get('receiver_uid', '') == resource.data.get('receiver_uid', '') ||
           request.resource.data.receiver_uid == request.auth.uid);
      }

      // Sender can cancel or re-invite, receiver can accept or reject
      allow update: if senderUnchanged() && (
        (isReceiver() && request.resource.data.status in ['accepted', 'rejected'] && receiverIsSelf())
        || (isSender() && request.resource.data.status in ['cancelled', 'pending']));

      // Sender or receiver can permanently delete connection requests
      allow delete: if isSender() || isReceiver();
    }

    // SOS Alerts Collection
    match /sos_alerts/{alertId} {
      function isSender() {
        return isAuthenticated() && (
          ('senderId' in resource.data && resource.data.senderId == request.auth.uid) ||
          ('sender_uid' in resource.data && resource.data.sender_uid == request.auth.uid)
        );
      }

      function isRecipient() {
        return isAuthenticated() && (
          ('recipientUids' in resource.data && request.auth.uid in resource.data.recipientUids) ||
          (request.auth.token.email != null && 'recipientEmails' in resource.data &&
           (request.auth.token.email in resource.data.recipientEmails ||
            request.auth.token.email.lower() in resource.data.recipientEmails))
        );
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Create: Authenticated AND sender field equals request.auth.uid.
      // Always starts active, ring 0, expiring within 3 h, timestamped by the server.
      allow create: if isAuthenticated() && (
        ('senderId' in request.resource.data && request.resource.data.senderId == request.auth.uid) ||
        ('sender_uid' in request.resource.data && request.resource.data.sender_uid == request.auth.uid)
      )
        && request.resource.data.status == 'active'
        && request.resource.data.get('ringSeq', 0) == 0
        && request.resource.data.get('origin', '') in ['manual', 'automatic']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'h')
        && request.resource.data.triggeredAt == request.time;

      // Read: Authenticated AND (sender OR recipient)
      allow read: if isSender() || isRecipient();

      // Update:
      // Sender can update tracking fields, recipient escalation lists, resolve the alert, push its
      // expiry forward and deliberately re-ring it (ringSeq + 1, dismissals cleared).
      // Recipients can update status (resolve only), resolvedAt, dismissedBy, acknowledgedBy,
      // acknowledgedAt, lastRespondedAt.
      // Nobody may move an ended alert back to active.
      allow update: if (isSender() &&
        changed().hasOnly([
          'status',
          'resolvedAt',
          'liveLocation',
          'liveUpdatedAt',
          'batteryLevel',
          'isTrackingActive',
          'isDuress',
          'lastUpdatedAt',
          'latitude',
          'longitude',
          'google_maps_url',
          'location',
          'recipientUids',
          'recipientEmails',
          'escalationLevel',
          'escalationLog',
          'recentTrail',
          // Sender marks a resolved alert as a false alarm from the history screen
          'falseAlarm',
          'falseAlarmAt',
          // Alert lifecycle: expiry and deliberate re-alert
          'expiresAt',
          'ringSeq',
          'dismissedBy'
        ])
        // nobody revives an ended alert
        && !(resource.data.get('status', '') != 'active' && request.resource.data.get('status', '') == 'active')
        // the sender may only clear dismissals (on a re-ring), never edit them
        && (!changed().hasAny(['dismissedBy']) || request.resource.data.dismissedBy.size() == 0)
        && (!changed().hasAny(['ringSeq']) ||
            request.resource.data.ringSeq == resource.data.get('ringSeq', 0) + 1)
        && (!changed().hasAny(['expiresAt']) ||
            request.resource.data.expiresAt <= request.time + duration.value(3, 'h')))
        ||
        (isRecipient() &&
        changed().hasOnly([
          'status',
          'resolvedAt',
          'dismissedBy',
          'acknowledgedBy',
          'acknowledgedAt',
          'lastRespondedAt'
        ])
        // a guardian may resolve an alert, never re-activate it or invent a status
        && (!changed().hasAny(['status']) || request.resource.data.status == 'resolved'));

      // Delete: Denied (alerts are immutable emergency records)
      allow delete: if false;

      // Emergency Incident Room Events Subcollection
      match /events/{eventId} {
        allow read: if isSender() || isRecipient();
        allow create: if isSender() || isRecipient();
      }
    }

    // Safe Journeys Collection
    match /journeys/{journeyId} {
      function isJourneyOwner() {
        return isAuthenticated() && (
          ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
          ('owner_uid' in resource.data && resource.data.owner_uid == request.auth.uid)
        );
      }

      function isJourneyGuardian() {
        // Phone-only accounts have no email claim, so read it with a default instead of erroring
        let email = request.auth.token.get('email', null);
        return isAuthenticated() && (
          ('guardianUids' in resource.data && request.auth.uid in resource.data.guardianUids) ||
          (email != null && 'guardianEmails' in resource.data &&
           email.lower() in resource.data.guardianEmails)
        );
      }

      // Create: Authenticated user creates journey with themselves as owner
      allow create: if isAuthenticated() && (
        ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
        ('owner_uid' in request.resource.data && request.resource.data.owner_uid == request.auth.uid)
      );

      // Read: Owner or listed guardian
      allow read: if isJourneyOwner() || isJourneyGuardian();

      // Update: Only owner can update tracking, status, check-ins, or cancel
      allow update: if isJourneyOwner();

      // Delete: Denied or only owner when cancelled/arrived
      allow delete: if isJourneyOwner() && resource.data.status in ['cancelled', 'arrived'];
    }

    // Ride Safety Check-ins Collection
    match /ride_checkins/{rideId} {
      function isRideOwner() {
        return isAuthenticated() && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
          ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid)
        );
      }

      function isRideGuardian() {
        // Phone-only accounts have no email claim, so read it with a default instead of erroring
        let email = request.auth.token.get('email', null);
        return isAuthenticated() && (
          ('guardianIds' in resource.data && request.auth.uid in resource.data.guardianIds) ||
          (email != null && 'guardianEmails' in resource.data &&
           email.lower() in resource.data.guardianEmails)
        );
      }

      // Create: Authenticated user creates check-in with themselves as user
      allow create: if isAuthenticated() && (
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
        ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid)
      );

      // Read: Owner or listed guardian
      allow read: if isRideOwner() || isRideGuardian();

      // Update: Owner can update trail, status, and arrival; guardians can update when acknowledging/viewing
      // but can never reassign ownership or the guardian lists
      allow update: if isRideOwner() ||
        (isRideGuardian() &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['userId', 'ownerId', 'guardianIds', 'guardianEmails']));

      // Delete: Denied for safety audit trail
      allow delete: if false;
    }

    // Community Safety Reports Collection (Heatmap & Crowdsourced hazards)
    match /safety_reports/{reportId} {
      // Anyone can read safety reports (even guest users for public safety awareness)
      allow read: if true;

      // Only authenticated users can submit safety reports with their own userId
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Authenticated users can increment verification count
      allow update: if isAuthenticated();

      allow delete: if false;
    }
  }
}
